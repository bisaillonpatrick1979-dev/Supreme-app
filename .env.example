# ========================================
# HailiteManager - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values

# ─── SUPABASE ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── GOOGLE CLOUD STORAGE ────────────────
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=hailite-manager-photos
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_GCS_BASE_URL=https://storage.googleapis.com/hailite-manager-photos

# ─── STRIPE ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── GOOGLE MAPS ─────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── APP CONFIG ──────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── EMAIL (optional - Phase 2) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hailite.com
